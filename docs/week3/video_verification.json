  "caption_events": [
    {
      "start": 0.0,
      "end": 10.0,
      "text": "本機完整推論操作錄影\n無旁白，以繁體中文字幕說明",
      "chapter": "01 投打與目前情境"
    },
    {
      "start": 10.0,
      "end": 20.0,
      "text": "選擇德保拉對李凱威\n依投打與目前情境重新計算",
      "chapter": "01 投打與目前情境"
    },
    {
      "start": 20.0,
      "end": 28.0,
      "text": "修改出局數與壘包狀態\n新結果完成前先清除舊推薦",
      "chapter": "01 投打與目前情境"
    },
    {
      "start": 28.0,
      "end": 47.0,
      "text": "新增本打席第一球與第二球\n球種、落點、球速與結果可編輯",
      "chapter": "02 歷程與即時機率"
    },
    {
      "start": 47.0,
      "end": 56.0,
      "text": "從完整歷程自動重建球數\n兩球後顯示一壞一好",
      "chapter": "02 歷程與即時機率"
    },
    {
      "start": 56.0,
      "end": 68.0,
      "text": "本次推論已使用兩球歷程\n機率圖與熱圖依目前輸入更新",
      "chapter": "02 歷程與即時機率"
    },
    {
      "start": 68.0,
      "end": 84.0,
      "text": "候選配球依估計失分變化排序\n只比較有資料支持的球種與落點",
      "chapter": "03 推薦與不確定性"
    },
    {
      "start": 84.0,
      "end": 96.0,
      "text": "分開呈現投手、打者與直接對戰樣本\n預測集合可能包含多個球種或區域",
      "chapter": "03 推薦與不確定性"
    },
    {
      "start": 96.0,
      "end": 103.0,
      "text": "推薦根據歷史觀測資料\n尚未證實能降低實戰失分",
      "chapter": "03 推薦與不確定性"
    },
    {
      "start": 103.0,
      "end": 118.0,
      "text": "相同驗證集比較三項預測任務\n依事前規則選擇歷程 LightGBM",
      "chapter": "04 驗證選模與校準"
    },
    {
      "start": 118.0,
      "end": 128.0,
      "text": "球種、落點、投球結果分別檢查\n保留 GRU 與基準的比較結果",
      "chapter": "04 驗證選模與校準"
    },
    {
      "start": 128.0,
      "end": 148.0,
      "text": "校準與集合門檻使用獨立日期\n保留稽核呈現實測覆蓋率",
      "chapter": "04 驗證選模與校準"
    },
    {
      "start": 148.0,
      "end": 169.0,
      "text": "2025 最終測試保持模型與校準器凍結\n全體球種 log loss 比頻率基準差 2.27%",
      "chapter": "05 2025 最終測試與基準限制"
    },
    {
      "start": 169.0,
      "end": 180.0,
      "text": "線上名單內子集另行揭露\n球種 log loss 比頻率基準改善 3.56%",
      "chapter": "05 2025 最終測試與基準限制"
    },
    {
      "start": 180.0,
      "end": 199.0,
      "text": "全體球種集合實測覆蓋 83.74%\n低於名目 90%，沒有重調測試門檻",
      "chapter": "05 2025 最終測試與基準限制"
    },
    {
      "start": 199.0,
      "end": 218.0,
      "text": "此段模擬推論 API 回應 503\n呈現服務失敗提示與展示備案",
      "chapter": "06 模擬服務錯誤與固定案例"
    },
    {
      "start": 218.0,
      "end": 233.0,
      "text": "切換固定示範案例\n僅讀取預存結果，欄位唯讀",
      "chapter": "06 模擬服務錯誤與固定案例"
    },
    {
      "start": 233.0,
      "end": 245.0,
      "text": "少量樣本案例揭露直接對戰 0 球\n固定案例不接受任意情境即時推論",
      "chapter": "06 模擬服務錯誤與固定案例"
    },
    {
      "start": 245.0,
      "end": 257.0,
      "text": "以 390 px viewport 模擬手機寬度\n這是桌面瀏覽器，未使用實體手機",
      "chapter": "07 手機寬度與回到即時模式"
    },
    {
      "start": 257.0,
      "end": 270.0,
      "text": "固定案例在窄畫面仍顯示唯讀與可信度\n頁面採正常縱向捲動閱讀",
      "chapter": "07 手機寬度與回到即時模式"
    },
    {
      "start": 270.0,
      "end": 280.0,
      "text": "回到桌面與本機即時模式\n模型版本與歷史資料截止日保持可見",
      "chapter": "07 手機寬度與回到即時模式"
    }
